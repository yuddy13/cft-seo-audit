# Copy this file to .env.local and fill in values
# The app stores API keys encrypted in the SQLite DB.
# This env var is used as the encryption key for that storage.
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# Path to the SQLite database file (default: ./data/smb.db)
DATABASE_PATH=./data/smb.db

# Optional: set to 'production' for production builds
NODE_ENV=development
